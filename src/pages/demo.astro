---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import DemoForm from "../components/DemoForm.astro";
---
<Base title="Попробовать демо" path="/demo/"
  description="Введите название клиники и прайс — получите демо-бота, который отвечает по вашим услугам и записывает на тестовое расписание.">
  <PageHero eyebrow="Демо" title="Ваш бот на ваших услугах за минуту"
    lead="Введите название клиники и прайс. Мы создадим временного демо-бота с тестовыми врачами и расписанием — напишите ему как пациент." />
  <section class="section">
    <div class="container demo">
      <DemoForm />
      <aside class="card help">
        <h2 class="h-sm">Что проверить</h2>
        <ul>
          <li>Спросите цену услуги из вашего списка — и той, которой там нет.</li>
          <li>Попросите записаться на завтра вечером.</li>
          <li>Напишите «болит зуб и опухла щека» — бот передаст диалог человеку.</li>
          <li>Скажите «я подумаю».</li>
        </ul>
        <p class="note">Врачи и расписание в демо вымышленные. SMS и уведомления сотрудникам не отправляются.</p>
      </aside>
    </div>
  </section>
</Base>
<style>
  .demo { display: grid; gap: var(--s-6); align-items: start; }
  @media (min-width: 960px) { .demo { grid-template-columns: 1.4fr 1fr; } }
  .help { background: var(--sakura); border: none; }
  .h-sm { font-size: 1.6rem; }
</style>
