---
import Logo from "../Logo.astro";
import { url } from "../../config";
interface Props { demo: string | null }
const { demo } = Astro.props;
const links = [{href: '#how', label: 'Как работает'}, {href: '#features', label: 'Возможности'}, {href: '#start', label: 'Стоимость'}];
---
<header class="home-header">
  <div class="container home-bar">
    <Logo />
    <nav class="home-nav" aria-label="Разделы главной страницы">
      {links.map(link => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a class="home-demo" href={demo ? url(demo) : '#audit'}>{demo ? 'Демо' : 'Аудит'}</a>
    <details class="home-menu">
      <summary aria-label="Открыть меню"><span></span><span></span><span></span></summary>
      <nav aria-label="Мобильное меню">
        {links.map(link => <a href={link.href}>{link.label}</a>)}
        <a href="#calculator">Калькулятор потерь</a>
        <a href={demo ? url(demo) : '#audit'}>{demo ? 'Попробовать демо' : 'Получить аудит'}</a>
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.home-menu');
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', event => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
</script>
<style>
  .home-header { background: #fcf6ee; border-bottom: 1px solid #efe5dc; position: relative; z-index: 20; }
  .home-bar { min-height: 92px; display: flex; align-items: center; gap: 48px; }
  .home-bar :global(.logo span) { font-size: 2rem; letter-spacing: -.03em; }
  .home-bar :global(.logo svg) { width: 42px; }
  .home-nav { margin-left: auto; display: flex; gap: 38px; }
  .home-nav a { color: #29231e; font-size: 14px; text-decoration: none; font-weight: 600; }
  .home-nav a:hover { color: #b52c22; text-decoration: underline; text-underline-offset: 6px; }
  .home-demo { border: 1px solid #b62c23; border-radius: 50px; color: #38251d; padding: 10px 28px; font-size: 14px; text-decoration: none; transition: background-color 160ms; }
  .home-demo:hover { background: #f5e7db; }
  .home-menu { display: none; position: relative; margin-left: auto; }
  .home-menu summary { width: 44px; height: 44px; display: grid; place-content: center; gap: 4px; cursor: pointer; list-style: none; }
  .home-menu summary::-webkit-details-marker { display: none; }
  .home-menu summary span { width: 21px; height: 2px; background: #302921; border-radius: 2px; }
  .home-menu nav { position: absolute; right: 0; top: 52px; width: min(300px, 86vw); border-radius: 16px; background: #fffaf4; box-shadow: 0 12px 40px #38251d26; padding: 12px; }
  .home-menu nav a { display: block; padding: 13px 16px; font-size: 15px; color: #38251d; text-decoration: none; border-radius: 8px; }
  .home-menu nav a:hover { background: #f4e9df; }
  @media (max-width: 800px) {
    .home-bar { min-height: 74px; }
    .home-bar :global(.logo span) { font-size: 1.65rem; }
    .home-bar :global(.logo svg) { width: 32px; }
    .home-nav, .home-demo { display: none; }
    .home-menu { display: block; }
  }
</style>
