---
/** Five falling petals, CSS only; off with prefers-reduced-motion. */
---
<div class="petals" aria-hidden="true">
  <i style="--x: 12%; --d: 13s; --t: 0s"></i>
  <i style="--x: 34%; --d: 16s; --t: 4s"></i>
  <i style="--x: 58%; --d: 14s; --t: 8s"></i>
  <i style="--x: 76%; --d: 18s; --t: 2s"></i>
  <i style="--x: 90%; --d: 15s; --t: 10s"></i>
</div>
<style>
  .petals { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .petals i {
    position: absolute; top: -20px; left: var(--x); width: 11px; height: 8px;
    background: #f2c4c0; border-radius: 8px 0 8px 0; opacity: .8;
    animation: fall var(--d) linear var(--t) infinite;
  }
  @keyframes fall {
    0% { transform: translate(0, -20px) rotate(0); opacity: 0; }
    10% { opacity: .8; }
    100% { transform: translate(-60px, 110vh) rotate(260deg); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .petals { display: none; } }
</style>
