---
/** The ScarletFlow mark: a vermilion seal with one flowing line. */
interface Props { size?: number; title?: string }
const { size = 40, title } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 48 48" role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"} aria-label={title} focusable="false">
  <circle cx="24" cy="24" r="22" fill="#c8322a" />
  <path d="M7 27.5c4.2-5.2 8.4-5.2 12.6 0s8.4 5.2 12.6 0 6.4-4.6 9.3-2.2" fill="none" stroke="#fbf6ec" stroke-width="3.4" stroke-linecap="round" />
  <path d="M12 19.5c3-3.2 6-3.2 9 0" fill="none" stroke="#fbf6ec" stroke-width="2.2" stroke-linecap="round" opacity=".75" />
</svg>
