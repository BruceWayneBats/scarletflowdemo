---
import { url } from "../config";
---
<section class="section section--paper2">
  <div class="container cta">
    <div>
      <h2>Попробуйте на своих услугах</h2>
      <p class="lead">Введите название клиники и прайс — через минуту получите демо-бота. Без звонков и регистрации.</p>
    </div>
    <div class="actions">
      <a class="btn btn--primary" href={url("/demo/")}>Попробовать демо</a>
      <a class="btn btn--ghost" href={url("/#audit")}>Получить аудит потерь</a>
    </div>
  </div>
</section>
<style>
  .cta { display: grid; gap: var(--s-5); align-items: center; }
  @media (min-width: 900px) { .cta { grid-template-columns: 1.4fr 1fr; } .cta .actions { justify-content: flex-end; } }
</style>
