---
import { url } from "../config";
import { hero } from "../content/product";
import { demoPath, nichePath } from "../niches";
import type { ActiveNiche } from "../niches/types";
interface Props { niche: ActiveNiche }
const { niche } = Astro.props;
const demo = demoPath(niche);
---
<section class="section section--paper2">
  <div class="container cta">
    <div>
      <h2>{demo ? "Попробуйте на своих услугах" : "Посчитаем ваши потери"}</h2>
      <p class="lead">{niche.cta.lead}</p>
    </div>
    <div class="actions">
      {demo && <a class="btn btn--primary" href={url(demo)}>{hero.primary}</a>}
      <a class={demo ? "btn btn--ghost" : "btn btn--primary"} href={url(nichePath(niche, "/#audit"))}>{hero.audit}</a>
    </div>
  </div>
</section>
<style>
  .cta { display: grid; gap: var(--s-5); align-items: center; }
  @media (min-width: 900px) { .cta { grid-template-columns: 1.4fr 1fr; } .cta .actions { justify-content: flex-end; } }
</style>
