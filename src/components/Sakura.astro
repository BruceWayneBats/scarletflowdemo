---
/** A thin sakura branch. Decoration only: hidden from screen readers. */
interface Props { class?: string; flip?: boolean }
const { class: cls = "", flip = false } = Astro.props;
const flowers = [
  { x: 118, y: 40, r: 1 }, { x: 176, y: 62, r: 0.8 }, { x: 70, y: 74, r: 0.9 }, { x: 214, y: 30, r: 0.7 },
];
---
<svg class={`sakura ${cls}`} viewBox="0 0 260 120" aria-hidden="true" focusable="false"
  style={flip ? "transform: scaleX(-1)" : undefined}>
  <path d="M4 112C40 96 74 82 104 58s58-34 96-36 44-6 56-16" fill="none" stroke="#7a5a43"
    stroke-width="2" stroke-linecap="round" />
  <path d="M104 58c10 6 30 8 50 2M150 34c4 12 14 22 26 28M60 84c4-8 6-14 8-22" fill="none"
    stroke="#7a5a43" stroke-width="1.4" stroke-linecap="round" />
  {flowers.map((f) => (
    <g transform={`translate(${f.x} ${f.y}) scale(${f.r})`}>
      {[0, 72, 144, 216, 288].map((a) => (
        <ellipse cx="0" cy="-8" rx="5.5" ry="8.5" fill="#f2c4c0" stroke="#e3a6a1" stroke-width=".8"
          transform={`rotate(${a})`} />
      ))}
      <circle r="2.6" fill="#c8322a" />
    </g>
  ))}
</svg>
<style>
  .sakura { pointer-events: none; }
</style>
